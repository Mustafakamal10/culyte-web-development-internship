        {
          "name": "4. Combined Query (?page=1&limit=5&role=user&search=ali)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users?page=1&limit=5&role=user&search=ali",
